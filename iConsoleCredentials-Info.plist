<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.authentication-services-credential-provider-ui</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).CredentialProviderViewController</string>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>ASCredentialProviderExtensionCapabilities</key>
			<dict>
				<!-- 암호 앱 "선택한 항목을 앱으로 내보내기" 를 받는다 (자격 증명 교환). 애플 문서 ASCredentialImportManager:
				     SupportsCredentialExchange = YES, SupportedCredentialExchangeVersions = ["1.0"].
				     (처음엔 시스템 안에서 찾은 비슷한 이름 SupportedCredentialExchangeFormatVersions 만 넣어 목록에 안 나왔다 — 그 이름도 남겨 둔다) -->
				<key>SupportsCredentialExchange</key>
				<true/>
				<key>SupportedCredentialExchangeVersions</key>
				<array>
					<string>1.0</string>
				</array>
				<key>SupportedCredentialExchangeFormatVersions</key>
				<array>
					<string>1.0</string>
				</array>
				<!-- Safari · Chrome 자동 완성: 설정에서 켠 때만 실제로 채운다 (꺼 두면 아무것도 내주지 않는다) -->
				<key>ProvidesPasswords</key>
				<true/>
				<!-- 패스키 · 인증 코드도 받는다고 선언 (암호 앱이 내보내기 대상으로 보는 조건인지 시험, 2026-11-23). 실제로 내주는 건 암호뿐 -->
				<key>ProvidesPasskeys</key>
				<true/>
				<key>ProvidesOneTimeCodes</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
