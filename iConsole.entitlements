<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 계정 목록·그룹·즐겨찾기는 iCloud Drive 앱 전용 폴더에 둬서 맥끼리 동기화한다 (iSQL 과 같은 방식). 샌드박스는 쓰지 않는다 -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.moimz.iConsole</string>
	</array>
	<key>com.apple.developer.ubiquity-container-identifiers</key>
	<array>
		<string>iCloud.com.moimz.iConsole</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudDocuments</string>
	</array>
	<!-- Developer ID 로 내보내도 같은 저장소를 쓰게 운영 환경으로 맞춘다 (iSQL·inPlayer·iFont 와 같음) -->
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<!-- 암호·OTP 는 iCloud 키체인(동기화 항목)에 둔다. 동기화 항목은 이 접근 그룹이 있어야 쓸 수 있다 -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.moimz.iConsole</string>
	</array>
</dict>
</plist>
